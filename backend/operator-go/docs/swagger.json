{
    "swagger": "2.0",
    "info": {
        "description": "High-performance analytics and aggregation for operators",
        "title": "Betasafar Operator API (Go)",
        "contact": {},
        "version": "1.0"
    },
    "host": "api.betasafar.app/operator",
    "basePath": "/",
    "paths": {
        "/analytics/highload": {
            "get": {
                "description": "Revenue trends, conversion rates",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "analytics"
                ],
                "summary": "High-load analytics",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/bookings/pending": {
            "get": {
                "description": "List of pending bookings",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "bookings"
                ],
                "summary": "Get pending bookings",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    }
                }
            }
        },
        "/notifications/broadcast": {
            "post": {
                "description": "Operator broadcasts update to all booked pilgrims (placeholder)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "notifications"
                ],
                "summary": "Broadcast to package pilgrims",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Package ID",
                        "name": "packageId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Message title",
                        "name": "title",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Message body",
                        "name": "message",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/packages/home-aggregation": {
            "get": {
                "description": "Fast stats for operator dashboard",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard"
                ],
                "summary": "Get home aggregation",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/payments/highload": {
            "get": {
                "description": "Total paid, pending, balance",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "payments"
                ],
                "summary": "Payment aggregates",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    }
}
